# Nix
result
result-*

# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Secrets - GitHub Copilot OAuth token
darwin/.config/github-copilot/hosts.json
darwin/.config/configstore/

# Emacs temporary and generated files
darwin/.emacs.d/.cache/
darwin/.emacs.d/.claude/
darwin/.emacs.d/elpaca/
darwin/.emacs.d/auto-save-list/
darwin/.emacs.d/backups/
darwin/.emacs.d/*.elc
darwin/.emacs.d/recentf
darwin/.emacs.d/transient/
darwin/.emacs.d/tree-sitter/
darwin/.emacs.d/eshell/
darwin/.emacs.d/url/
darwin/.emacs.d/games/
darwin/.emacs.d/tramp
darwin/.emacs.d/places
darwin/.emacs.d/bookmarks
darwin/.emacs.d/custom.el
darwin/.emacs.d/.lsp-session-*
darwin/.emacs.d/projectile-bookmarks.eld

# Raycast - auto-generated extension bundles (rebuilt by Raycast itself)
darwin/.config/raycast/extensions/
# Raycast - contains a plaintext API token; managed/regenerated by Raycast
darwin/.config/raycast/config.json

# Machine-specific runtime state & tool-generated files (not real config)
# lazytail - search history, session, update-check timestamp (churns on use)
darwin/.config/lazytail/*.json
# Gatsby CLI - telemetry UUID / PID / lastRun / absolute paths
darwin/.config/gatsby/
# Wireshark - UI state & preferences regenerated on exit
darwin/.config/wireshark/
# GitHub Copilot - language-server version manifest (tool-managed)
darwin/.config/github-copilot/versions.json
# Karabiner-Elements - auto-generated dated config snapshots
darwin/.config/karabiner/automatic_backups/
# Ghostty - auto-generated config backups (config.<hash>.bak)
darwin/.config/ghostty/config.*.bak
# herdr - ログとセッション状態（端末スクロールバックを含むため機密性の観点でも追跡しない）
darwin/.config/herdr/herdr-client.log
darwin/.config/herdr/herdr-server.log
darwin/.config/herdr/session.json
darwin/.config/herdr/session-history.json
# herdr - キーバインド移行時の自動バックアップ（config.toml と同内容）
darwin/.config/herdr/config.toml.bak-*
# herdr - 起動時に取得するリリースノートのキャッシュ
darwin/.config/herdr/release-notes.json
# hunk - 最終確認 CLI バージョンを保持するだけの状態ファイル
darwin/.config/hunk/state.json

# Ubuntu - home-manager generated files
ubuntu/.config/direnv/
ubuntu/.config/environment.d/
ubuntu/.config/fish/
ubuntu/.config/git/
ubuntu/.config/home-manager/
ubuntu/.config/systemd/

# home-manager が生成する /nix/store シンボリックリンク（コミット禁止。新マシンで壊れる）
darwin/.config/fish/config.fish
darwin/.config/git/config
darwin/.config/direnv/lib/hm-nix-direnv.sh

# fish のランタイム状態（マシン固有・set -U が書き換える）
darwin/.config/fish/fish_variables

# OrbStack が再生成する補完（インストール後に自動生成。新マシンでは dangling）
darwin/.config/fish/completions/docker.fish
darwin/.config/fish/completions/kubectl.fish
darwin/.config/fish/completions/orbctl.fish

# Cursor がランタイムで書き換える設定（machine state として扱う）
darwin/.cursor/cli-config.json
darwin/.cursor/hooks.json

# シークレット: gh の OAuth トークンを含む（git から除去すること）
darwin/.config/gh/hosts.yml

# ---- Arch (niri/Wayland デスクトップ) ----

# シークレット: gh の OAuth トークンを含む
arch/.config/gh/hosts.yml

# mozc の学習データ（入力した文章そのものを含む。公開リポジトリには絶対に入れない）
# config1.db だけが設定で、それ以外は履歴・学習結果。
arch/.config/mozc/*.db
!arch/.config/mozc/config1.db
arch/.config/mozc/.*

# fcitx5 が生成するキーボードレイアウトのキャッシュ
arch/.config/fcitx5/conf/cached_layouts

# herdr - ログとセッション状態（端末スクロールバックを含むため機密性の観点でも追跡しない）
arch/.config/herdr/

# 各種ツールが作る自動バックアップ
arch/**/*.bak
arch/**/*.bak-*
arch/.config/ghostty/config.*.bak

# fish のランタイム状態（マシン固有・set -U が書き換える）
arch/.config/fish/fish_variables

# fisher が入れたプラグイン本体は ~ 側にだけ置く（fish_plugins から復元できる）
arch/.config/fish/functions/fisher.fish
arch/.config/fish/functions/_fzf_*.fish
arch/.config/fish/functions/fzf_configure_bindings.fish
arch/.config/fish/functions/_autopair_*.fish
arch/.config/fish/conf.d/fzf.fish
arch/.config/fish/conf.d/autopair.fish
arch/.config/fish/completions/
