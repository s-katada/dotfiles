+/// Re-enters prefix mode after a prefix action when `[keys] prefix_sticky`
+/// is enabled, so the user can chain actions until Enter or Esc exits.
+/// Actions that deliberately moved to another mode (copy, resize, dialogs,
+/// pickers) are left alone; only the "action finished, back to terminal"
+/// transition is reverted.
+fn restore_sticky_prefix(state: &mut AppState) {
+    if state.prefix_sticky && state.active.is_some() && state.mode == Mode::Terminal {
+        state.mode = Mode::Prefix;
+    }
+}
