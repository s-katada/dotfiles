+    fn sticky_prefix_app() -> App {
+        let (_api_tx, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = App::new(
+            &Config::default(),
+            true,
+            None,
+            api_rx,
+            crate::api::EventHub::default(),
+        );
+        app.state.workspaces = vec![Workspace::test_new("test")];
+        app.state.active = Some(0);
+        app.state.selected = 0;
+        app.state.prefix_sticky = true;
+        app.state.mode = Mode::Prefix;
+        app
+    }
+
+    #[test]
+    fn sticky_prefix_stays_after_pane_focus_action() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Char('h'), KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Prefix);
+    }
+
+    #[test]
+    fn sticky_prefix_stays_after_zoom_action() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Char('z'), KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Prefix);
+    }
+
+    #[test]
+    fn sticky_prefix_enter_exits_to_terminal() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Enter, KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Terminal);
+    }
+
+    #[test]
+    fn sticky_prefix_esc_exits_to_terminal() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Esc, KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Terminal);
+    }
+
+    #[test]
+    fn sticky_prefix_swallows_unbound_key() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Char('0'), KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Prefix);
+    }
+
+    #[test]
+    fn sticky_prefix_respects_mode_switching_action() {
+        let mut app = sticky_prefix_app();
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Char('r'), KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Resize);
+    }
+
+    #[test]
+    fn non_sticky_prefix_exits_after_action() {
+        let mut app = sticky_prefix_app();
+        app.state.prefix_sticky = false;
+
+        app.handle_prefix_key(TerminalKey::new(KeyCode::Char('h'), KeyModifiers::empty()));
+
+        assert_eq!(app.state.mode, Mode::Terminal);
+    }
 }
