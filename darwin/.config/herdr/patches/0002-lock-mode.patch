+    fn lock_key_toggles_lock_and_bypasses_prefix() {
+        let mut app = sticky_prefix_app();
+        app.state.prefix_sticky = false;
+        app.state.mode = Mode::Terminal;
+        app.state.keybinds.lock = crate::config::ActionKeybinds::direct("ctrl+g");
+
+        app.handle_terminal_key_headless(TerminalKey::new(
+            KeyCode::Char('g'),
+            KeyModifiers::CONTROL,
+        ));
+        assert!(app.state.locked);
+        assert_eq!(app.state.mode, Mode::Terminal);
+
+        // While locked the prefix key is forwarded instead of opening prefix mode.
+        app.handle_terminal_key_headless(TerminalKey::new(
+            app.state.prefix_code,
+            app.state.prefix_mods,
+        ));
+        assert_eq!(app.state.mode, Mode::Terminal);
+        assert!(app.state.locked);
