+            KeyCode::Char('g'),
+            KeyModifiers::CONTROL,
+        ));
+        assert!(!app.state.locked);
+
+        app.handle_terminal_key_headless(TerminalKey::new(
+            app.state.prefix_code,
+            app.state.prefix_mods,
+        ));
+        assert_eq!(app.state.mode, Mode::Prefix);
+    }
