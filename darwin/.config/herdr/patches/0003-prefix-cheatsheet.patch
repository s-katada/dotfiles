+    /// Like [`Self::prefix_rhs_label`] but only the first prefix binding,
+    /// for compact cheatsheet entries that show one key per action.
+    pub fn first_prefix_rhs_label(&self) -> Option<String> {
+        self.bindings
+            .iter()
+            .find(|binding| binding.trigger.is_prefix())
+            .map(|binding| {
+                binding
+                    .label
+                    .strip_prefix("prefix+")
+                    .unwrap_or(&binding.label)
+                    .to_string()
+            })
+    }
