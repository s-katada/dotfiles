+/// Zellij-style cheatsheet entries for the prefix bar: one `key description`
+/// pair per bound action, most-used first so right-edge truncation on narrow
+/// terminals drops the least important entries. Unbound actions are skipped.
+fn extend_prefix_cheatsheet_spans(
+    app: &AppState,
+    key: Style,
+    dim: Style,
+    spans: &mut Vec<Span<'static>>,
+) {
+    let kb = &app.keybinds;
+    let mut push = |label: String, desc: &str| {
+        spans.push(Span::styled(label, key));
+        spans.push(Span::styled(format!(" {desc}  "), dim));
+    };
+
+    if let Some(label) = quad_prefix_label(
+        &kb.focus_pane_left,
+        &kb.focus_pane_down,
+        &kb.focus_pane_up,
+        &kb.focus_pane_right,
+    ) {
+        push(label, "focus");
+    }
+    if let Some(label) = quad_prefix_label(
+        &kb.swap_pane_left,
+        &kb.swap_pane_down,
+        &kb.swap_pane_up,
+        &kb.swap_pane_right,
+    ) {
+        push(label, "swap");
+    }
+    if let Some(label) = kb.split_horizontal.first_prefix_rhs_label() {
+        push(label, "split─");
+    }
+    if let Some(label) = kb.split_vertical.first_prefix_rhs_label() {
+        push(label, "split│");
+    }
+    if let Some(label) = kb.close_pane.first_prefix_rhs_label() {
+        push(label, "close");
+    }
+    if let Some(label) = kb.zoom.first_prefix_rhs_label() {
+        push(label, "zoom");
+    }
+    if let Some(label) = kb.rename_pane.first_prefix_rhs_label() {
+        push(label, "rename");
+    }
+    if let Some(label) = kb.cycle_pane_next.first_prefix_rhs_label() {
+        push(label, "cycle");
+    }
+    if let Some(label) = kb.new_tab.first_prefix_rhs_label() {
+        push(label, "new tab");
+    }
+    if let Some(label) = prefix_indexed_label(&kb.switch_tab) {
+        push(label, "tab");
+    }
+    if let Some(label) = kb.close_tab.first_prefix_rhs_label() {
+        push(label, "close tab");
+    }
+    if let Some(label) = kb.copy_mode.first_prefix_rhs_label() {
+        push(label, "copy");
+    }
+    if let Some(label) = kb.resize_mode.first_prefix_rhs_label() {
+        push(label, "resize");
+    }
+    if let Some(label) = kb.workspace_picker.first_prefix_rhs_label() {
+        push(label, "workspace");
+    }
+    if let Some(label) = kb.detach.first_prefix_rhs_label() {
+        push(label, "detach");
+    }
+}
+
+/// Compact label for a left/down/up/right action group. Same-modifier
+/// single-key bindings collapse into e.g. `h/j/k/l` or `shift+h/j/k/l`;
+/// anything else falls back to joining the full labels. `None` when any
+/// direction has no prefix binding.
+fn quad_prefix_label(
+    left: &crate::config::ActionKeybinds,
+    down: &crate::config::ActionKeybinds,
+    up: &crate::config::ActionKeybinds,
+    right: &crate::config::ActionKeybinds,
+) -> Option<String> {
+    let labels = [
+        left.first_prefix_rhs_label()?,
+        down.first_prefix_rhs_label()?,
+        up.first_prefix_rhs_label()?,
+        right.first_prefix_rhs_label()?,
+    ];
+    let parts: Vec<(Option<&str>, &str)> = labels
+        .iter()
+        .map(|label| match label.rsplit_once('+') {
+            Some((modifiers, key)) => (Some(modifiers), key),
+            None => (None, label.as_str()),
+        })
+        .collect();
+    let shared_modifiers = parts[0].0;
+    if parts
+        .iter()
+        .all(|(modifiers, key)| *modifiers == shared_modifiers && key.chars().count() == 1)
+    {
+        let keys = parts
+            .iter()
+            .map(|(_, key)| *key)
+            .collect::<Vec<_>>()
+            .join("/");
+        Some(match shared_modifiers {
+            Some(modifiers) => format!("{modifiers}+{keys}"),
+            None => keys,
+        })
+    } else {
+        Some(labels.join("/"))
+    }
+}
+
+/// `1..9`-style label from the first prefix-triggered indexed binding.
+fn prefix_indexed_label(bindings: &[crate::config::IndexedKeybind]) -> Option<String> {
+    let first = bindings
+        .iter()
+        .find(|binding| binding.trigger.is_prefix() && binding.label.ends_with('1'))?;
+    let rhs = first
+        .label
+        .strip_prefix("prefix+")
+        .unwrap_or(&first.label);
+    Some(format!("{rhs}..9"))
+}
