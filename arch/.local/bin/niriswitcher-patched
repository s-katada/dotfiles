#!/usr/bin/python
# niriswitcher に「左右矢印キーでの選択」を足して起動するラッパー。
#
# niriswitcher の config.toml は 1 アクションに 1 キーしか割り当てられない
# (keys.switch の next/prev は単一文字列のみ。上流 main でも同じ) ため、
# Tab と矢印キーを併用するには本体のキーバインド生成に差し込むしかない。
# site-packages 側は書き換えず起動前に monkeypatch するので、
# パッケージ更新で消えない。niri の spawn-at-startup からこれを起動する。
import sys

# gtk4-layer-shell は libwayland より先にロードされている必要がある。
# 本家 daemon() は Gtk を import する前に CDLL でプリロードするが、
# このラッパーは monkeypatch のために先に _app を import してしまうので、
# 同じプリロードをここで(あらゆる gi import より前に)やっておく。
# これを怠ると layer surface の初期化に失敗して通常ウィンドウとして表示され、
# niri のフォーカスリングが背後に描かれる。
from ctypes import CDLL

CDLL("libgtk4-layer-shell.so.0")

import gi

gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from niriswitcher import _app, _widgets, _wm, daemon
from niriswitcher._config import config
from gi.repository import Gdk, Gio, Gtk


# macOS の Dock バッジ風の通知表示。
# Slack / Discord などの Electron アプリはメンション・DM 数のバッジを
# com.canonical.Unity.LauncherEntry の Update シグナル (D-Bus) で配信するので、
# それを常時購読しておき、スイッチャーのアイコンに赤バッジとして重ねる。
# - count (メンション/DM 数) がある → 赤丸 + 数字
# - 数字なしの注意喚起 (LauncherEntry の urgent または niri の urgent) → 赤ドット
# 注意: シグナルは変化時にしか流れないので、このデーモンの起動後に
# 変化があったアプリのバッジだけが表示できる。
_badges = {}


def _normalize_badge_key(app_uri):
    key = app_uri.lower()
    if key.startswith("application://"):
        key = key[len("application://") :]
    if key.endswith(".desktop"):
        key = key[: -len(".desktop")]
    return key


def _on_launcher_entry_update(conn, sender, path, iface, signal, params):
    app_uri, props = params.unpack()
    _badges.setdefault(_normalize_badge_key(app_uri), {}).update(props)


Gio.bus_get_sync(Gio.BusType.SESSION, None).signal_subscribe(
    None,
    "com.canonical.Unity.LauncherEntry",
    "Update",
    None,
    None,
    Gio.DBusSignalFlags.NONE,
    _on_launcher_entry_update,
)


def _badge_for_window(window):
    # flatpak だと desktop id が com.slack.Slack のような逆ドメインになるので、
    # 完全一致に加えて最後のドット区切り (slack) 同士でも突き合わせる。
    keys = set()
    if window.app_id:
        keys.add(window.app_id.lower())
    if window.app_info is not None:
        keys.add(_normalize_badge_key(window.app_info.get_id() or ""))
    for badge_key, entry in _badges.items():
        short = badge_key.rsplit(".", 1)[-1]
        for key in keys:
            if badge_key == key or short == key or short == key.rsplit(".", 1)[-1]:
                return entry
    return None


_orig_application_view_init = _widgets.ApplicationView.__init__


def _application_view_init_with_badge(self, window, *, size):
    _orig_application_view_init(self, window, size=size)
    entry = _badge_for_window(window) or {}
    count = entry.get("count", 0) if entry.get("count-visible", False) else 0
    urgent = window.is_urgent or entry.get("urgent", False)
    if count <= 0 and not urgent:
        return
    # アイコンを Gtk.Overlay で包み直して右上にバッジを重ねる。
    icon = self.get_first_child()
    self.remove(icon)
    overlay = Gtk.Overlay()
    overlay.set_child(icon)
    badge = Gtk.Label()
    badge.add_css_class("notification-badge")
    if count > 0:
        badge.set_label(str(count) if count < 100 else "99+")
    else:
        badge.add_css_class("dot")
    badge.set_halign(Gtk.Align.END)
    badge.set_valign(Gtk.Align.START)
    badge.set_can_target(False)
    overlay.add_overlay(badge)
    self.prepend(overlay)


_widgets.ApplicationView.__init__ = _application_view_init_with_badge


# 本家はワークスペースを Gtk.Stack で 1 つずつ表示し Super+↑↓ でスライドさせるが、
# 全ワークスペースを縦に並べて常時表示したいので、Stack と同じインターフェイスを
# 持つ縦並びの Box に差し替える。「表示中の子」の概念は「操作対象 (アクティブ) の
# ワークスペース行」に読み替え、アクティブ行には CSS クラス active-workspace を
# 付けて style.css 側でほんのり明るくする。Super+↑↓ は行の移動になる。
class AllWorkspacesBox(Gtk.Box):
    def __init__(self, max_width=None, min_width=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.set_name("workspaces")
        self.max_width = max_width
        self.min_width = min_width
        self.indicator = None
        self._current = None
        self._names = {}

    # _app が Gtk.Stack 前提で呼ぶメソッド。全行表示なのでアニメーションは無い。
    def set_transition_duration(self, duration):
        pass

    def set_transition_type(self, transition):
        pass

    def set_width(self, min_width, max_width):
        self.min_width = min_width
        self.max_width = max_width
        for workspace_view in self:
            workspace_view.set_width(min_width, max_width)

    def set_indicator(self, indicator):
        for indicator_child in list(indicator):
            indicator.remove(indicator_child)
        for workspace_view in self:
            indicator.append_workspace(workspace_view.workspace)
        self.indicator = indicator
        self.indicator.connect("selection-changed", self.on_selection_changed)

    def add_named(self, workspace_view, name):
        self._names[name] = workspace_view
        self.append(workspace_view)
        # unified モード (separate_workspaces = false) ではインジケータからの
        # selection-changed が来ないので、最初の行をアクティブにしておく。
        if self._current is None:
            self._set_current(workspace_view)

    def add_workspace(self, workspace_view):
        if self.indicator:
            self.indicator.append_workspace(workspace_view.workspace)
        self.add_named(workspace_view, workspace_view.workspace.identifier)

    def get_child_by_name(self, name):
        return self._names.get(name)

    def get_visible_child(self):
        return self._current

    def remove(self, child):
        self._names = {
            name: view for name, view in self._names.items() if view is not child
        }
        if self._current is child:
            self._current = None
        super().remove(child)

    def _set_current(self, workspace_view):
        if self._current is workspace_view:
            return
        if self._current is not None:
            self._current.remove_css_class("active-workspace")
            # 全行が見えているので、離れる行のアプリ選択ハイライトは消す
            # (current_application は保持されるので、戻れば select_current で復活)。
            for application_view in self._current:
                application_view.deselect()
        self._current = workspace_view
        workspace_view.add_css_class("active-workspace")

    def on_selection_changed(self, widget, workspace, animate):
        workspace_view = self._names.get(workspace.identifier)
        if workspace_view is not None:
            self._set_current(workspace_view)
            workspace_view.select_current()

    def __iter__(self):
        current = self.get_first_child()
        while current is not None:
            yield current
            current = current.get_next_sibling()


_app.WorkspaceStack = AllWorkspacesBox

# 上流バグの修正: Window.__init__ が super().__init__() より前に self.app_info を
# 参照するため常に else 側に落ち、name が空になる (アイコンはローカル変数を使う
# ので正常に出る)。プロパティは init 後には正しく入っているので、init の後に
# name を引き直す。macOS 風 UI で選択中アイコンの下に出すアプリ名に使われる。
_orig_window_init = _wm.Window.__init__


def _window_init_with_name(self, window, last_focus_time=None):
    _orig_window_init(self, window, last_focus_time)
    if self.app_info is not None:
        self.name = self.app_info.get_display_name()
    elif self.app_id:
        self.name = self.app_id


_wm.Window.__init__ = _window_init_with_name

_orig_create_keybindings = _app.NiriswitcherWindow._create_keybindings


def _create_keybindings_with_arrows(self):
    mappings = _orig_create_keybindings(self)
    # 修飾キー (Super) を押したまま Right/Left で次/前のアプリを選択。
    mappings.append(
        _app.KeybindingAction(
            (Gdk.KEY_Right, config.keys.modifier_mask),
            self.select_next_application,
        )
    )
    mappings.append(
        _app.KeybindingAction(
            (Gdk.KEY_Left, config.keys.modifier_mask),
            self.select_prev_application,
        )
    )
    return mappings


_app.NiriswitcherWindow._create_keybindings = _create_keybindings_with_arrows

if __name__ == "__main__":
    sys.exit(daemon())
