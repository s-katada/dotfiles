#!/usr/bin/env bash
# wf-recorder による画面録画のトグル (niri + Wayland)。
#
#   niri-screenrec [region|screen]   録画開始。既に録画中なら停止 (トグル)
#   niri-screenrec stop              停止のみ
#   niri-screenrec status            録画中なら exit 0、停止中なら exit 1
#
# 停止時に出力パスをクリップボードへコピーする。通知は D-Bus 直叩き
# (libnotify 不要)。環境変数で上書き可:
#   SCREENREC_DIR    既定 ~/Videos/Recordings
#   SCREENREC_CODEC  既定 h264_nvenc (RTX 5080 の NVENC)
#   SCREENREC_FPS    既定 30
#   SCREENREC_CQ     既定 23 (小さいほど高画質・大容量)
set -uo pipefail

dir="${SCREENREC_DIR:-$HOME/Videos/Recordings}"
codec="${SCREENREC_CODEC:-h264_nvenc}"
fps="${SCREENREC_FPS:-30}"
run="${XDG_RUNTIME_DIR:-/tmp}"
pidfile="$run/niri-screenrec.pid"
metafile="$run/niri-screenrec.meta"   # 1行目=出力パス, 2行目=通知ID
logfile="$run/niri-screenrec.log"

# notify <replace_id> <timeout_ms> <title> <body> -> 通知ID を stdout
notify() {
    gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "niri-screenrec" "$1" "camera-video" "$3" "$4" "[]" "{}" "$2" \
        2>/dev/null | grep -oE '[0-9]+' | head -1
}

notify_close() {
    [ -n "${1:-}" ] || return 0
    gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification "$1" >/dev/null 2>&1
}

is_recording() {
    [ -f "$pidfile" ] || return 1
    local pid; pid="$(cat "$pidfile" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

stop_recording() {
    local pid out nid size
    pid="$(cat "$pidfile" 2>/dev/null)"
    out="$(sed -n 1p "$metafile" 2>/dev/null)"
    nid="$(sed -n 2p "$metafile" 2>/dev/null)"

    # SIGINT で wf-recorder に正常終了させる (mp4 の moov atom を書かせるため)
    kill -INT "$pid" 2>/dev/null
    for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null

    rm -f "$pidfile" "$metafile"
    notify_close "$nid"

    if [ -s "$out" ]; then
        printf '%s' "$out" | wl-copy
        size="$(du -h "$out" | cut -f1)"
        notify 0 6000 "録画を保存しました" "$(basename "$out") ($size) — パスをコピーしました" >/dev/null
    else
        notify 0 8000 "録画に失敗しました" "$(tail -n 3 "$logfile" 2>/dev/null | tr '\n' ' ')" >/dev/null
    fi
}

start_recording() {
    local mode="$1" geom out pid nid
    mkdir -p "$dir"
    out="$dir/rec-$(date +%Y%m%d-%H%M%S).mp4"

    local -a args=(-f "$out" -c "$codec" -x yuv420p -r "$fps" -y)
    # ffmpeg 既定は 2000 kb/s 固定で 4K には低すぎるので、品質基準 (CQ/CRF) に切り替える
    case "$codec" in
    *nvenc)
        args+=(-p preset=p5 -p tune=hq -p rc=vbr -p cq="${SCREENREC_CQ:-23}" -p b=0)
        ;;
    libx264 | libx265)
        args+=(-p preset=veryfast -p crf="${SCREENREC_CQ:-23}")
        ;;
    esac
    case "$mode" in
    region)
        geom="$(slurp -d)" || exit 0        # ESC で中断したら何もしない
        [ -n "$geom" ] || exit 0
        args+=(-g "$geom")
        ;;
    screen)
        args+=(-o "$(niri msg --json focused-output | jq -r '.name')")
        ;;
    esac

    wf-recorder "${args[@]}" >"$logfile" 2>&1 &
    pid=$!
    echo "$pid" >"$pidfile"

    # コーデック非対応などで即死していないか確認してから「録画中」を出す
    sleep 0.8
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pidfile"
        notify 0 10000 "録画を開始できませんでした" \
            "$(tail -n 3 "$logfile" 2>/dev/null | tr '\n' ' ')" >/dev/null
        exit 1
    fi

    nid="$(notify 0 0 "🔴 録画中" "$(basename "$out") — もう一度押すと停止")"
    printf '%s\n%s\n' "$out" "$nid" >"$metafile"
}

mode="${1:-region}"
case "$mode" in
stop)
    is_recording && stop_recording
    ;;
status)
    is_recording
    ;;
region | screen)
    if is_recording; then stop_recording; else start_recording "$mode"; fi
    ;;
*)
    echo "usage: ${0##*/} [region|screen|stop|status]" >&2
    exit 2
    ;;
esac
