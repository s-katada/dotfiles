{
  "layer": "top",
  "position": "left",
  "width": 52,
  "spacing": 6,

  // 縦バーでは left=上、center=中央、right=下
  "modules-left": ["niri/workspaces"],
  "modules-center": [],
  "modules-right": [
    "tray", "custom/notification", "pulseaudio", "network", "bluetooth", "cpu", "memory", "clock"
  ],

  "niri/workspaces": { "format": "{value}", "all-outputs": false },

  // spacing は 0。アイテム間の隙間は style.css の #tray > * の margin で作る。
  "tray": { "icon-size": 18, "spacing": 0 },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#b3243c'>󰂜</span>",
      "none": "󰂚",
      "dnd-notification": "<span foreground='#b3243c'>󰂛</span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "<span foreground='#b3243c'>󰂜</span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "<span foreground='#b3243c'>󰂛</span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    // Bluetooth 機器が出力先のときは専用アイコンにする (blueman / bluez 経由)。
    "format-bluetooth": "󰂰",
    "format-bluetooth-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}\n{volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰌢",
    "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "切断されています"
  },

  // Bluetooth。クリックで blueman-manager を開く (GUI 側は blueman-applet が常駐)。
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "cpu": { "format": "󰻠\n{usage}%", "interval": 3, "tooltip": true },

  "memory": { "format": "󰍛\n{percentage}%", "interval": 5, "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "format": { "today": "<span color='#7a3fb0'><b>{}</b></span>" } }
  }
}
