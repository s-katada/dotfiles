# imv の設定。niri はタイトルバーを描かないので、素の imv だとどのファイルを
# 見ているのか画面上に一切出ない。overlay を既定で出してパスを表示する。
#
# 注意: imv は「最初に見つかった 1 つの config」しか読まず、マージしない。
# そのため /etc/imv_config の [binds] をここに丸ごと持ってきている
# (これを削ると suppress_default_binds が効かなくなり挙動が変わる)。
# imv を更新したら /etc/imv_config と diff を取ること。

[options]

# Suppress built-in key bindings, and specify them explicitly in this
# config file.
suppress_default_binds = true

# 画面上部に「ファイル名 + ディレクトリ」を出す (d キーで表示/非表示をトグル)。
# overlay_text は shell 展開されるので、組み立てはヘルパースクリプトに任せる
# (設定行に sed / パイプを詰め込むと壊れやすく、括弧は wordexp で問題になりうる)。
overlay = true
overlay_font = Monospace:12
overlay_position_bottom = false
overlay_text = $($HOME/.local/bin/imv-overlay-label)
[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# alias = command to run

[binds]
# Define some key bindings
q = quit
y = exec echo working!

# Image navigation
<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming
<Up> = zoom 1
<Shift+plus> = zoom 1
i = zoom 1
<Down> = zoom -1
<minus> = zoom -1
o = zoom -1

# Rotate Clockwise by 90 degrees
<Ctrl+r> = rotate by 90

# Other commands
x = close
f = fullscreen
d = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1
